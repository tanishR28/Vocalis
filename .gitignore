# --------------------------------------------------
# OS / editor
# --------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --------------------------------------------------
# Python
# --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Virtual environments (any location)
.venv/
venv/
env/
backend/.venv/
backend/venv/
ML/.venv/
ML/venv/

# --------------------------------------------------
# Node / Next.js (frontend lives at frontend/ or Frontend/)
# --------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.vercel/
**/.vercel/
coverage/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --------------------------------------------------
# Secrets — never commit
# --------------------------------------------------
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local
Frontend/.env.local

# Allow examples only
!.env.example
!**/.env.example
!frontend/.env.example
!Frontend/.env.example

# --------------------------------------------------
# Runtime / temp audio
# --------------------------------------------------
backend/temp_*
**/temp_*
*.wav
*.mp3
*.ogg
*.flac
*.webm

# --------------------------------------------------
# Local notes & one-off reports (not part of the app)
# --------------------------------------------------
note.txt
*.pdf

# --------------------------------------------------
# Root-level raw audio datasets (your own training WAVs)
# NOT the ML synthetic CSV pipeline under ML/datasets/
# --------------------------------------------------
/datasets/

# --------------------------------------------------
# ML — generated training data & trained weights
# Code under ML/ IS tracked. After clone: run datasets/generate.py
# and training/train_*.py to produce models locally.
# --------------------------------------------------
ML/data/
ML/datasets/**/*.csv
ML/models/*.pkl
ML/models/*.joblib
ML/models/*.keras
ML/models/*.h5
ML/models/*.pth
ML/__pycache__/
ML/**/__pycache__/
