# Copy to backend/.env (dev) or set in Render/Railway dashboard (production)

# Required in production — cloud disks are ephemeral; history lives in Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Comma-separated frontend origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
