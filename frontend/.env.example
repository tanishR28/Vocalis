# Copy to frontend/.env.local (dev) or set in Vercel (production)

# FastAPI backend — use your Render/Railway URL in production
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (required for multi-user / production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# true = require login (use true on Vercel production)
NEXT_PUBLIC_REQUIRE_AUTH=false
